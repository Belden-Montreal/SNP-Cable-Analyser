<stylesheet>

    <paraStyle name="h1"
    fontSize="27"
    leading="17"
    spaceBefore = "14"
    />

    <paraStyle name="h2"
    fontSize="15"
    leading="17"
    spaceBefore = "15"
    />

    <paraStyle name="page_title"
    fontSize="14.5"
    alignment = "CENTRE"
    />

    <paraStyle name="param_data"
    fontSize="11"
    alignment = "LEFT"
    />

    <paraStyle name="table_line_header"
    fontSize="12"
    leading="10"
    spaceBefore = "12"
    textColor="green" 
    />

