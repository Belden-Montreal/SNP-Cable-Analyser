<?xml version="1.0" encoding="utf-8" standalone="no" ?> 
<!DOCTYPE document SYSTEM "rml.dtd"> 

<document filename= "{{filename}}"> 

{{script}}

# short name for  formatting function.
from reportPackages.rlextra.radxml.html_cleaner import cleanInline as i
from reportPackages.rlextra.radxml.html_cleaner import cleanBlocks as b

#the current date
import datetime
today = datetime.date.today()


{{endscript}}


<template pageSize="(595, 842)" leftMargin="50" rightMargin="50"  showBoundary="0">

    <pageTemplate id="param">
        <pageGraphics>
            <image file="{{RML_DIR}}/belden_logo.png" x="50" y="712" width = "100"  preserveAspectRatio="1"/>
        </pageGraphics>
        <frame id="body" x1="50" y1="50" width="495" height="712"/> 
    </pageTemplate>

</template>

<stylesheet>

    <paraStyle name="h1"
    fontSize="27"
    leading="17"
    spaceBefore = "14"
    />

    <paraStyle name="h2"
    fontSize="15"
    leading="17"
    spaceBefore = "15"
    />

    <paraStyle name="page_title"
    fontSize="14.5"
    alignment = "CENTRE"
    leading="17"
    spaceBefore = "14"
    />

    <paraStyle name="param_data"
    fontSize="11"
    alignment = "LEFT"
    leading="17"
    spaceBefore = "17"
    />

    <blockTableStyle id="extraData">
        <blockSpan start="0, -1" stop="1, -1"/>
        <blockSpan start="0, -2" stop="1, -2"/>

    </blockTableStyle>



</stylesheet>

<story>  


   {{ for sample in samples}}
        {{if sample.type == "SNP" : }}
            {{ for param in sample.params}}
               

                <para style="page_title"> {{param.name}} </para>  
                {{if param.standard is not None}}
                <para style="param_data">{{param.pass_fail}}</para>  
                {{endif}}

                <para style="param_data">Sample : {{sample.name}}</para>  
                {{if param.standard is not None}}
                <para style="param_data">Standard : {{param.standard}}</para>  
                {{endif}}
                {{if param.standard is not None}}
                <blockTable align="CENTER" style = "extraData">
                {{else}}
                <blockTable align="CENTER">
                {{endif}}
                    <tr>
                        <td>Freq ({{sample.freq_unit}})</td>
                        {{ for line in param.lines}}
                            <td>{{line.name}}</td>
                        {{endfor}}
                    </tr>
                    
                    {{ for i in range(len(param.testPoints['freq'])) }}
                    <tr>
                        {{ for key, val in param.testPoints.items() }}
                            <td  > {{val[i]}} </td>
                        {{endfor}}
                    </tr>
                    {{endfor}}

                    {{if param.standard is not None}}


                    <tr>
                        <td> Worst distance from limit</td>
                       <td></td>
                        {{ for key, (f, v) in param.worst_margin.items() }}
                            <td  > {{v}} </td>
                        {{endfor}}
                    </tr> 

                    <tr>
                        <td>@Freq</td>
                       <td></td>
                        {{ for key, (f, v) in param.worst_margin.items() }}
                            <td  > {{f}} </td>
                        {{endfor}}
                        
                    </tr> 
                    {{endif}}


            
                </blockTable>

            <nextFrame/>
            {{endfor}}
        {{endif}}
    {{endfor }}

  
</story>  
</document>